# .claude/CLAUDE.md.template
#
# Not tracked as ~/.claude/CLAUDE.md itself, and not symlinked — Claude Code
# writes runtime state into settings/session files that live alongside it,
# and this file is meant to diverge per device anyway. On a new machine:
#
#   cp ~/.dotfiles/.claude/CLAUDE.md.template ~/.claude/CLAUDE.md
#
# then fill in / delete the sections below. The @import line is the only
# part every device keeps identically — it pulls in the shared personal
# preferences (commit workflow, pixi usage) from the dotfiles repo, so
# editing CLAUDE.shared.md once updates every device without touching
# this file again.

@~/.dotfiles/.claude/CLAUDE.shared.md

