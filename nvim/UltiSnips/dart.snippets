
snippet im "Import" b
import 'package:$1/${2:$1}.dart';
endsnippet
snippet main "Dart main method" b
void main() {
	${1}
}
endsnippet
snippet ident "Anonymous identity method" w
(${1:_}) => $1
endsnippet
snippet st
static ${1}
endsnippet
snippet fi
final ${1}
endsnippet
snippet re
return ${1}
endsnippet
snippet br
break;
endsnippet
snippet th
throw ${1}
endsnippet
snippet cl
class ${1:`vim_snippets#Filename("", "untitled")`} ${2}
endsnippet
snippet in
interface ${1:`vim_snippets#Filename("", "untitled")`} ${2}
endsnippet
snippet imp
implements ${1}
endsnippet
snippet ext
extends ${1}
endsnippet
snippet if
if (${1:true}) {
	${2}
}
endsnippet
snippet ife
if (${1:true}) {
	${2}
} else {
	${3}
}
endsnippet
snippet el
else
endsnippet
snippet sw
switch (${1}) {
	${2}
}
endsnippet
snippet cs
case ${1}:
${2}
endsnippet
snippet de
default:
${1}
endsnippet
snippet for
for (var ${2:i} = 0, len = ${1:things}.length; $2 < len; ${3:++}$2) {
	${4:$1[$2]}
}
endsnippet
snippet fore
for (final ${2:item} in ${1:itemList}) {
	${3}
}
endsnippet
snippet wh
while (${1:/* condition */}) {
	${2}
}
endsnippet
snippet dowh
do {
	${2}
} while (${1:/* condition */});
endsnippet
snippet as
assert(${1:/* condition */});
endsnippet
snippet try "Try/catch block" b
try {
	${1:${VISUAL}}

} catch(${2:e}${3:, st}) {
	$4

}
endsnippet
snippet tryf "Try/catch/finally block" b
try {
	${1:${VISUAL}}

} catch(${2:e}${3:, st}) {
	$4
} finally {
}
endsnippet
snippet r "Single statement return" b
$1 $2($3) => $0;
endsnippet
snippet ar "Async anonymous single statement method" w
($1) async => $0
endsnippet

priority 1
snippet m "Instance or top level method" b
${1:void} $2($3) {
	$0
}
endsnippet
snippet am "Async instance or top level method" b
Future<${1:void}> $2($3) async {
	$0
}
endsnippet
snippet ar "Async single statement return" b
Future<$1> $2($3) async => $0;
endsnippet

