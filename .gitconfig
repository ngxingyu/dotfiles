[user]
	email = ng.xingyu@u.nus.edu
	name = Ng Xing Yu
[alias]
  st = status
  ci = commit -v
  co = checkout
  di = diff
  br = branch
  ad = add
[http]
  sslverify = false
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
[diff]
  tool = meld
[core]
  editor = nvim
[init]
  defaultBranch = main
[help]
  autocorrect = 1
[pull]
  rebase = false
[color]
  ui = true

# Kept last so a per-machine ~/.gitconfig.local (gitignored) can actually
# override the defaults above -- git's last-value-wins, so an [include] before
# [user] etc. (as this used to be ordered) can never win a conflict.
[include]
	path = ~/.gitconfig.local
